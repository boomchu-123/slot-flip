#!/bin/sh
# The C compiler for PicoDrive's 32-bit ARM build: cores/armv7-zigcc for
# everything, except that its hand-written assembly goes to GNU as.
#
# PicoDrive's 68000 core (Cyclone), its YM2612 mixer and its memory helpers are
# assembly in the old pre-UAL spelling (`stmneia`, `ldrcch`). GNU as takes both
# spellings; the assembler inside clang, which Zig uses, takes only the new one.
# Assembly carries no C library dependency, so only these files need the cross
# GNU toolchain (gcc-arm-linux-gnueabihf) and the C stays on Zig and glibc 2.17.
#
# Two consequences. The assembly writes absolute addresses into its tables, which
# a shared library can only hold as text relocations, so the link is told to allow
# them (lld refuses by default; the console's loader handles them). And it is
# assembled for a Cortex-A7 with NEON, the same as the C.
here="$(cd "$(dirname "$0")" && pwd)"
for a; do
	case "$a" in
	*.s | *.S)
		exec arm-linux-gnueabihf-gcc -march=armv7-a -mfpu=neon-vfpv4 -mfloat-abi=hard -c "$@"
		;;
	-shared)
		exec "$here/../armv7-zigcc" "$@" -Wl,-z,notext
		;;
	esac
done
exec "$here/../armv7-zigcc" "$@"
