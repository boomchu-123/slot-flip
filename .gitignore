# Parallel implementation worktrees, never content.
/.worktrees

# flip port
/target-flip/
/SlotDiag-my355.zip
flip/Tools/my355/SlotSmoke.pak/flip_smoke
flip/Tools/my355/SlotInput.pak/flip_input
flip/Tools/my355/SlotEvdev.pak/flip_evdev
# The built frontend binary is generated by CI (and locally); never committed.
flip/Tools/my355/Slot.pak/slot
# The emulator cores and their licences ARE committed so CI can package the
# full Slot.pak without building the cores (they are prebuilt for the Flip).
!flip/Tools/my355/Slot.pak/System/
!flip/Tools/my355/Slot.pak/System/*.so
/vendor/

# Experimental miyoomini (Miyoo Mini Plus) port.
/target-mini/
