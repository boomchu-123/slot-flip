/target
**/*.rs.bk
*.pdb

/docs/
/CLAUDE.md
/.ralph/
/.superpowers/

/vendor
/sdcard
/dist
*.dylib
*.so

.DS_Store
/.idea/
/target-device
/target-verify
/dist-device
/site/public
/site/.cache

# Parallel implementation worktrees, never content.
/.worktrees

# flip port
/target-flip/
/SlotDiag-my355.zip
flip/Tools/my355/SlotSmoke.pak/flip_smoke
flip/Tools/my355/SlotInput.pak/flip_input
flip/Tools/my355/SlotEvdev.pak/flip_evdev
# The built frontend binary is generated by CI (and locally); never committed.
flip/Tools/my355/Slot.pak/slot
flip/Tools/miyoomini/Slot.pak/slot
flip/Tools/miyoomini/Slot.pak/slot.version
# The armhf cores ARE committed, like the Flip's, so the pak can be packaged
# without a cross build (the licence and source bundle sits beside them).
!flip/Tools/miyoomini/Slot.pak/System/
!flip/Tools/miyoomini/Slot.pak/System/*.so
# The emulator cores and their licences ARE committed so CI can package the
# full Slot.pak without building the cores (they are prebuilt for the Flip).
!flip/Tools/my355/Slot.pak/System/
!flip/Tools/my355/Slot.pak/System/*.so
/vendor/
.superpowers/

# Scratch build dirs from local/docker checks (never commit build output).
/target-*/

# Secrets and personal machine state. tools/check-sensitive.sh enforces this;
# these rules also keep the files out of `git add -A` by accident.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.ovpn
*.ppk
id_rsa*
id_ed25519*
.netrc
.pgpass
*.log

# Source photos for tools/fit_bitmaps.py (personal art, not redistributable).
/art-src/
__pycache__/
