flip/Tools/miyoomini/Slot.pak/slot

# Experimental my282 (Miyoo A30) port.
/target-a30/
/target-chk/
# Built frontend binary (armhf) is generated by CI; never committed.
flip/Tools/my282/Slot.pak/slot
